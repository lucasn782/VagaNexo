# Local development only. Copy to backend/.env.
# Never commit the copied file.

APP_NAME=VagaNexo AI
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# The port must match POSTGRES_PORT from the root .env file.
DATABASE_URL=postgresql+psycopg://vaganexo:change-me@127.0.0.1:5432/vaganexo

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Private storage and upload limits for Resume Importer
STORAGE_ROOT=../storage
RESUME_UPLOAD_DIR=uploads
RESUME_EXTRACTED_DIR=extracted
RESUME_TEMP_DIR=temporary
MAX_RESUME_UPLOAD_BYTES=10485760

# OpenAI-compatible API. No model is downloaded by this repository.
# Ollama:    http://127.0.0.1:11434/v1
# LM Studio: http://127.0.0.1:1234/v1
AI_PROVIDER=openai-compatible
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=llama3.1
AI_API_KEY=

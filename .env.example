# Local development only. Copy to .env and replace the placeholders.
# Never commit the copied file.

POSTGRES_DB=vaganexo
POSTGRES_USER=vaganexo
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
# Host port published only on 127.0.0.1. If 5432 is already in use,
# choose a free port and use the same value in backend DATABASE_URL.
POSTGRES_PORT=5432

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# OpenAI-compatible API. Examples:
# Ollama:    http://127.0.0.1:11434/v1
# LM Studio: http://127.0.0.1:1234/v1
AI_PROVIDER=openai-compatible
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=llama3.1
AI_API_KEY=
